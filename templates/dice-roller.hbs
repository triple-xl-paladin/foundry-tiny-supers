<!--
  DICE ROLLER
  -----------

  Three roll buttons: Normal, Advantage, Disadvantage.

  Layout follows the foundry-tinyd6 reference project:
    - Centered flex row of dark buttons
    - Each button has a Font Awesome dice icon + text label
    - data-roll attribute carries the roll type to the JS
-->
<section class="die-roller-content">

  <button type="button"
          class="roll-dice"
          data-roll="normal"
          title="Normal (2d6)">
    <span class="fas fa-dice"></span>
  </button>

  <button type="button"
          class="roll-dice"
          data-roll="advantage"
          title="Advantage (3d6)">
    <span class="fas fa-cubes"></span>
  </button>

  <button type="button"
          class="roll-dice"
          data-roll="disadvantage"
          title="Disadvantage (1d6)">
    <span class="fas fa-dice-d6"></span>
  </button>

</section>
